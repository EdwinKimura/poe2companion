{
  "expo": {
    "name": "Path of Exile 2 Companion",
    "slug": "poe2-companion",
    "version": "1.11.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "poe2companion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edwinkimura.poe2companion"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd3ca239-92e9-4537-a272-b82c7f6863a0"
      }
    }
  }
}
